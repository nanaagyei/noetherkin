{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["core/**/*.ts", "cli/**/*.ts", "adapters/runtime/**/*.ts", "adapters/hosts/**/*.ts", "tests/**/*.ts"]
}
