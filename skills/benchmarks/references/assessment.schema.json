{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-apprenticeship.example/schemas/3.0/assessment.schema.json",
  "title": "assessment",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": ["2.0", "3.0"]
    },
    "data_class": {
      "enum": [
        "live",
        "fixture"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "const": "team-lead"
        }
      },
      "required": [
        "id",
        "role"
      ],
      "additionalProperties": false
    },
    "kind": {
      "enum": [
        "baseline",
        "technical"
      ]
    },
    "learner_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "competency_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "unassessed",
              "developing",
              "demonstrated",
              "contested"
            ]
          },
          "demonstrated_level": {
            "enum": [
              null,
              "E0",
              "E1",
              "E2",
              "E3",
              "E4",
              "E5"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "competency_id",
          "status",
          "demonstrated_level",
          "evidence_ids",
          "rationale"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "scope": {
      "enum": [
        "checkpoint",
        "longitudinal"
      ]
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "design": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "artifact": {
              "type": "object",
              "properties": {
                "uri": {
                  "type": "string",
                  "format": "uri"
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "uri",
                "description",
                "revision"
              ],
              "additionalProperties": false
            },
            "decision": {
              "enum": [
                "approve",
                "rework",
                "insufficient-evidence"
              ]
            }
          },
          "required": [
            "artifact",
            "decision"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "data_class",
    "id",
    "created_at",
    "author",
    "kind",
    "learner_id",
    "project_id",
    "evidence_ids",
    "findings",
    "supersedes",
    "scope",
    "task_id",
    "design"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "longitudinal"
          }
        }
      },
      "then": {
        "properties": {
          "task_id": {
            "type": "null"
          },
          "design": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "const": "checkpoint"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "technical"
          },
          "task_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "baseline"
          }
        }
      },
      "then": {
        "properties": {
          "scope": {
            "const": "longitudinal"
          }
        }
      }
    }
  ]
}
