{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-apprenticeship.example/schemas/3.0/current-track.schema.json",
  "title": "current-track",
  "type": "object",
  "properties": {
    "schema_version": { "const": "3.0" },
    "data_class": { "enum": ["live", "fixture"] },
    "track_id": { "type": ["string", "null"], "minLength": 1 },
    "track_catalog_version": { "type": ["string", "null"], "minLength": 1 },
    "definition_digest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "selected_at": { "type": ["string", "null"], "format": "date-time" },
    "alignment_status": { "enum": ["unselected", "pending", "aligned"] },
    "adopted_competencies": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "scope_agreement": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/artifact" }] },
    "aligned_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "required": ["schema_version", "data_class", "track_id", "track_catalog_version", "definition_digest", "selected_at", "alignment_status", "adopted_competencies", "scope_agreement", "aligned_at"],
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "properties": { "uri": { "type": "string", "format": "uri" }, "revision": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 } },
      "required": ["uri", "revision", "description"], "additionalProperties": false
    }
  }
}
