{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-apprenticeship.example/schemas/3.0/track.schema.json",
  "title": "track",
  "type": "object",
  "properties": {
    "schema_version": { "const": "3.0" },
    "catalog_version": { "const": "1.1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "outcomes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "required_competencies": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "recommended_projects": {
      "type": "object",
      "properties": {
        "early": { "$ref": "#/$defs/tier" },
        "intermediate": { "$ref": "#/$defs/tier" },
        "advanced": { "$ref": "#/$defs/tier" }
      },
      "required": ["early", "intermediate", "advanced"],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "catalog_version", "id", "name", "description", "outcomes", "required_competencies", "recommended_projects"],
  "additionalProperties": false,
  "$defs": { "tier": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 2, "uniqueItems": true } }
}
