{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-apprenticeship.example/schemas/3.0/project.schema.json",
  "title": "project",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": ["2.0", "3.0"]
    },
    "data_class": {
      "enum": [
        "live",
        "fixture"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "repository_url": {
      "type": "string",
      "format": "uri"
    },
    "upstream_organization": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "primary_languages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "engineering_domains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "competencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "recommended_minimum_level": {
      "enum": [
        null,
        "E0",
        "E1",
        "E2",
        "E3",
        "E4",
        "E5"
      ]
    },
    "ideal_level": {
      "enum": [
        null,
        "E0",
        "E1",
        "E2",
        "E3",
        "E4",
        "E5"
      ]
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "difficulty": {
      "enum": [
        null,
        "bounded",
        "moderate",
        "complex",
        "ambiguous"
      ]
    },
    "onboarding_cost": {
      "enum": [null, "low", "medium", "high", "specialized"]
    },
    "feedback_loop": {
      "enum": [null, "fast", "moderate", "slow", "specialized"]
    },
    "contribution_readiness": {
      "type": "object",
      "properties": {
        "status": { "enum": ["verified", "conditional", "unverified"] },
        "signals": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "required": ["status", "signals", "limitations"],
      "additionalProperties": false
    },
    "onboarding_areas": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "learning_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "competencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "activities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "name",
          "competencies",
          "activities"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "deployment": {
      "type": ["object", "null"],
      "properties": {
        "environments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "environments",
        "requirements",
        "caveats"
      ],
      "additionalProperties": false
    },
    "contribution": {
      "type": ["object", "null"],
      "properties": {
        "guide_url": {
          "type": "string",
          "format": "uri"
        },
        "policy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "guide_url",
        "policy"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "candidate",
        "supported",
        "deprecated"
      ]
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "uri",
          "description",
          "revision"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata_gaps": {
      "type": "array",
      "items": {
        "enum": ["recommended_minimum_level", "ideal_level", "prerequisites", "difficulty", "onboarding_cost", "feedback_loop", "contribution_readiness", "deployment", "contribution"]
      },
      "uniqueItems": true
    },
    "support": {
      "type": "object",
      "properties": {
        "attachable": { "type": "boolean" },
        "task_packs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "required": ["attachable", "task_packs"],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "data_class",
    "id",
    "name",
    "repository_url",
    "upstream_organization",
    "description",
    "primary_languages",
    "technologies",
    "engineering_domains",
    "competencies",
    "recommended_minimum_level",
    "ideal_level",
    "prerequisites",
    "difficulty",
    "onboarding_areas",
    "learning_paths",
    "deployment",
    "contribution",
    "status",
    "caveats",
    "sources",
    "checked_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": "3.0" } } },
      "then": { "required": ["onboarding_cost", "feedback_loop", "contribution_readiness", "metadata_gaps", "support"] }
    },
    {
      "if": { "properties": { "schema_version": { "const": "3.0" }, "status": { "const": "supported" } }, "required": ["schema_version", "status"] },
      "then": {
        "properties": {
          "recommended_minimum_level": { "type": "string" }, "ideal_level": { "type": "string" }, "difficulty": { "type": "string" },
          "onboarding_cost": { "type": "string" }, "feedback_loop": { "type": "string" }, "deployment": { "type": "object" }, "contribution": { "type": "object" },
          "contribution_readiness": { "properties": { "status": { "const": "verified" } } }, "metadata_gaps": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "schema_version": { "const": "3.0" }, "status": { "const": "candidate" } }, "required": ["schema_version", "status"] },
      "then": {
        "allOf": [
          { "if": { "properties": { "recommended_minimum_level": { "type": "null" } } }, "then": { "properties": { "metadata_gaps": { "contains": { "const": "recommended_minimum_level" } } } } },
          { "if": { "properties": { "ideal_level": { "type": "null" } } }, "then": { "properties": { "metadata_gaps": { "contains": { "const": "ideal_level" } } } } },
          { "if": { "properties": { "difficulty": { "type": "null" } } }, "then": { "properties": { "metadata_gaps": { "contains": { "const": "difficulty" } } } } },
          { "if": { "properties": { "onboarding_cost": { "type": "null" } } }, "then": { "properties": { "metadata_gaps": { "contains": { "const": "onboarding_cost" } } } } },
          { "if": { "properties": { "feedback_loop": { "type": "null" } } }, "then": { "properties": { "metadata_gaps": { "contains": { "const": "feedback_loop" } } } } },
          { "if": { "properties": { "deployment": { "type": "null" } } }, "then": { "properties": { "metadata_gaps": { "contains": { "const": "deployment" } } } } },
          { "if": { "properties": { "contribution": { "type": "null" } } }, "then": { "properties": { "metadata_gaps": { "contains": { "const": "contribution" } } } } },
          { "if": { "properties": { "contribution_readiness": { "properties": { "status": { "const": "unverified" } } } } }, "then": { "properties": { "metadata_gaps": { "contains": { "const": "contribution_readiness" } } } } }
        ]
      }
    }
  ]
}
