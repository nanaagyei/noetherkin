{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-apprenticeship.example/schemas/3.0/evidence.schema.json",
  "title": "evidence",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": ["2.0", "3.0"]
    },
    "data_class": {
      "enum": [
        "live",
        "fixture"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "learner",
            "onboarding-coordinator",
            "project-curator",
            "peer-engineer",
            "team-lead",
            "manager",
            "user-agent",
            "promotion-reviewer"
          ]
        }
      },
      "required": [
        "id",
        "role"
      ],
      "additionalProperties": false
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "competency_id": {
      "type": "string",
      "minLength": 1
    },
    "fact": {
      "type": "object",
      "properties": {
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uri": {
                "type": "string",
                "format": "uri"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "uri",
              "description",
              "revision"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "observation",
        "observed_at",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "classification": {
          "enum": [
            "local",
            "component",
            "cross-component",
            "cross-service",
            "system",
            "multi-team"
          ]
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "classification",
        "components",
        "description"
      ],
      "additionalProperties": false
    },
    "difficulty": {
      "enum": [
        "bounded",
        "moderate",
        "complex",
        "ambiguous"
      ]
    },
    "assistance": {
      "type": "object",
      "properties": {
        "known": {
          "type": "boolean"
        },
        "highest_level": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 7
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "level": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "competencies": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "artifact": {
                "type": "object",
                "properties": {
                  "uri": {
                    "type": "string",
                    "format": "uri"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "uri",
                  "description",
                  "revision"
                ],
                "additionalProperties": false
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "recorder": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "enum": [
                      "learner",
                      "onboarding-coordinator",
                      "project-curator",
                      "peer-engineer",
                      "team-lead",
                      "manager",
                      "user-agent",
                      "promotion-reviewer"
                    ]
                  }
                },
                "required": [
                  "id",
                  "role"
                ],
                "additionalProperties": false
              },
              "provider": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "registered",
                      "external",
                      "unknown"
                    ]
                  },
                  "principal_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "principal_id",
                  "label"
                ],
                "additionalProperties": false
              },
              "recorded_at": {
                "type": "string",
                "format": "date-time"
              },
              "supersedes": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              }
            },
            "required": [
              "at",
              "level",
              "competencies",
              "description",
              "id",
              "recorder",
              "provider",
              "recorded_at",
              "supersedes"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "known",
        "highest_level",
        "events"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "unverified",
            "verified",
            "refuted"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "enum": [
                "learner",
                "onboarding-coordinator",
                "project-curator",
                "peer-engineer",
                "team-lead",
                "manager",
                "user-agent",
                "promotion-reviewer"
              ]
            }
          },
          "required": [
            "id",
            "role"
          ],
          "additionalProperties": false
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "status",
        "method",
        "reviewer",
        "checked_at"
      ],
      "additionalProperties": false
    },
    "interpretation": {
      "type": "object",
      "properties": {
        "independence": {
          "enum": [
            "independent",
            "guided",
            "implemented-by-other",
            "unknown"
          ]
        },
        "direction": {
          "enum": [
            "supporting",
            "contrary",
            "neutral"
          ]
        },
        "target_level": {
          "enum": [
            "E0",
            "E1",
            "E2",
            "E3",
            "E4",
            "E5"
          ]
        },
        "strength": {
          "enum": [
            "weak",
            "moderate",
            "strong"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "independence",
        "direction",
        "target_level",
        "strength",
        "rationale"
      ],
      "additionalProperties": false
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "data_class",
    "id",
    "created_at",
    "author",
    "project_id",
    "task_id",
    "competency_id",
    "fact",
    "scope",
    "difficulty",
    "assistance",
    "verification",
    "interpretation",
    "supersedes"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "project_id": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "task_id": {
            "type": "null"
          }
        }
      }
    }
  ]
}
