{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-apprenticeship.example/schemas/3.0/current-project.schema.json",
  "title": "current-project",
  "type": "object",
  "properties": {
    "schema_version": { "enum": ["2.0", "3.0"] },
    "data_class": {
