          "type": "null"
        },
        "selected_at": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "selected_at": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  ]
