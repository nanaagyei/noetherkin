{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-apprenticeship.example/schemas/1.0/task.schema.json",
  "title": "task",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "data_class": {
      "enum": [
        "live",
        "fixture"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "learner",
            "onboarding-coordinator",
            "project-curator",
            "peer-engineer",
            "team-lead",
            "manager",
            "user-agent",
            "promotion-reviewer"
          ]
        }
      },
      "required": [
        "id",
        "role"
      ],
      "additionalProperties": false
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "TRAINING",
        "PRODUCT",
        "UPSTREAM"
      ]
    },
    "status": {
      "enum": [
        "backlog",
        "assigned",
        "investigating",
        "designing",
        "implementing",
        "testing",
        "code-review",
        "validating",
        "task-review",
        "evidence-recording",
        "completed",
        "cancelled"
      ]
    },
    "problem": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "impact": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "criterion"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "primary_competencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "secondary_competencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "recommended_level": {
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4",
        "E5"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "classification": {
          "enum": [
            "local",
            "component",
            "cross-component",
            "cross-service",
            "system",
            "multi-team"
          ]
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "classification",
        "components",
        "description"
      ],
      "additionalProperties": false
    },
    "difficulty": {
      "enum": [
        "bounded",
        "moderate",
        "complex",
        "ambiguous"
      ]
    },
    "investigation_areas": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "testing_expectations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "documentation_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "assigned_by": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "learner",
            "onboarding-coordinator",
            "project-curator",
            "peer-engineer",
            "team-lead",
            "manager",
            "user-agent",
            "promotion-reviewer"
          ]
        }
      },
      "required": [
        "id",
        "role"
      ],
      "additionalProperties": false
    },
    "assistance_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "learner",
                  "onboarding-coordinator",
                  "project-curator",
                  "peer-engineer",
                  "team-lead",
                  "manager",
                  "user-agent",
                  "promotion-reviewer"
                ]
              }
            },
            "required": [
              "id",
              "role"
            ],
            "additionalProperties": false
          },
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "competencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "artifact": {
            "type": "object",
            "properties": {
              "uri": {
                "type": "string",
                "format": "uri"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "uri",
              "description",
              "revision"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "at",
          "actor",
          "level",
          "competencies",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "design_required": {
      "type": "boolean"
    },
    "code_review_required": {
      "type": "boolean"
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "completion_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "not-run"
            ]
          },
          "artifact": {
            "type": "object",
            "properties": {
              "uri": {
                "type": "string",
                "format": "uri"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "uri",
              "description",
              "revision"
            ],
            "additionalProperties": false
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "work_revision": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "criterion_id",
          "result",
          "artifact",
          "checked_at",
          "work_revision"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "learner",
                  "onboarding-coordinator",
                  "project-curator",
                  "peer-engineer",
                  "team-lead",
                  "manager",
                  "user-agent",
                  "promotion-reviewer"
                ]
              }
            },
            "required": [
              "id",
              "role"
            ],
            "additionalProperties": false
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "from",
          "to",
          "at",
          "actor",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "work_artifact": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "uri": {
              "type": "string",
              "format": "uri"
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "uri",
            "description",
            "revision"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "data_class",
    "id",
    "created_at",
    "author",
    "title",
    "project_id",
    "type",
    "status",
    "problem",
    "context",
    "impact",
    "acceptance_criteria",
    "constraints",
    "primary_competencies",
    "secondary_competencies",
    "recommended_level",
    "scope",
    "difficulty",
    "investigation_areas",
    "testing_expectations",
    "documentation_requirements",
    "assigned_by",
    "assistance_history",
    "design_required",
    "code_review_required",
    "blocked_reason",
    "completion_evidence_ids",
    "validation",
    "transitions",
    "work_artifact"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "completion_evidence_ids": {
            "minItems": 1
          },
          "validation": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
