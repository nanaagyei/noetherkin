{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-apprenticeship.example/schemas/1.0/assessment.schema.json",
  "title": "assessment",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "data_class": {
      "enum": [
        "live",
        "fixture"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "learner",
            "onboarding-coordinator",
            "project-curator",
            "peer-engineer",
            "team-lead",
            "manager",
            "user-agent",
            "promotion-reviewer"
          ]
        }
      },
      "required": [
        "id",
        "role"
      ],
      "additionalProperties": false
    },
    "kind": {
      "enum": [
        "baseline",
        "technical"
      ]
    },
    "learner_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "competency_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "unassessed",
              "developing",
              "demonstrated",
              "contested"
            ]
          },
          "demonstrated_level": {
            "enum": [
              null,
              "E0",
              "E1",
              "E2",
              "E3",
              "E4",
              "E5"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "competency_id",
          "status",
          "demonstrated_level",
          "evidence_ids",
          "rationale"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "data_class",
    "id",
    "created_at",
    "author",
    "kind",
    "learner_id",
    "project_id",
    "evidence_ids",
    "findings",
    "supersedes"
  ],
  "additionalProperties": false
}
