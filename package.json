{
  "name": "noetherkin",
  "version": "0.1.0",
  "description": "An agent-agnostic engineering apprenticeship simulator with portable mentoring skills and evidence-based progression",
  "license": "Apache-2.0",
  "private": true,
  "author": "Prince Agyei Tuffour",
  "repository": { "type": "git", "url": "git+https://github.com/nanaagyei/noetherkin.git" },
  "homepage": "https://github.com/nanaagyei/noetherkin#readme",
  "bugs": { "url": "https://github.com/nanaagyei/noetherkin/issues" },
  "keywords": ["engineering-education", "agent-skills", "developer-tools", "mentoring", "code-review", "apprenticeship"],
  "type": "module",
  "engines": { "node": ">=24" },
  "os": ["darwin", "linux"],
  "packageManager": "npm@11.9.0",
  "bin": { "noetherkin": "dist/cli/main.js" },
  "files": ["dist/core", "dist/cli", "dist/adapters/runtime", "dist/adapters/hosts", "schemas", "catalog", "tasks", "skills", "skill-pack/manifest.json", "docs/skills.md", "docs/cli.md", "docs/adapters.md", "docs/adapter-compatibility.md", "docs/bootstrap-runtime.md", "docs/deferred-validation.md", "docs/architecture", "CHANGELOG.md", "SECURITY.md", "NOTICE", "FOUNDATION_V1.md", "PROJECT_CHARTER.md", "noetherkin-logo.png", "noetherkin-logo-light.png"],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "validate:foundation": "python3 evaluations/validate_foundation.py",
    "validate:freeze": "python3 evaluations/validate_freeze.py",
    "verify": "npm test && npm run skills:check && npm run validate:foundation && npm run validate:freeze",
    "package:check": "node scripts/check-package.mjs",
    "release:check": "node scripts/check-release.mjs && npm run verify && npm run package:check",
    "pretest": "node scripts/prime-package-cache.mjs",
    "test": "npm run build && node --test dist/tests/*.test.js tests/*.test.mjs",
    "skills:bundle": "node scripts/package-skills.mjs",
    "skills:check": "node scripts/package-skills.mjs --check",
    "evals:check": "node tests/behavior/run.mjs check",
    "evals:run": "node tests/behavior/run.mjs run",
    "evals:continue": "node tests/behavior/run.mjs continue",
    "evals:report": "node tests/behavior/run.mjs report",
    "evals:review-template": "node tests/behavior/run.mjs review-template",
    "check": "tsc --noEmit",
    "prepack": "npm run skills:check && npm run build"
  },
  "dependencies": { "yaml": "^2.8.1" },
  "devDependencies": { "@types/node": "^24.0.0", "ajv": "^8.17.1", "ajv-formats": "^3.0.1", "typescript": "^5.9.2" }
}
